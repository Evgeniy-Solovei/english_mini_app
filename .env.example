# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=english-bot.live-dev.by

# PostgreSQL (the application does not use SQLite outside tests)
POSTGRES_DB=english_bot
POSTGRES_USER=english_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_NAME=english_bot
DB_USER=english_bot
DB_PASSWORD=replace-with-a-long-random-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional alternative to DB_* (URL-encode special characters in credentials):
# DATABASE_URL=postgresql://english_bot:password@db:5432/english_bot?sslmode=prefer

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://english-bot.live-dev.by/bot/webhook/
TELEGRAM_WEBAPP_URL=https://english-bot.live-dev.by/miniapp/
TELEGRAM_WEBHOOK_SECRET=replace-with-random-letters-digits-underscore-or-dash
TELEGRAM_INIT_DATA_MAX_AGE=86400

# Optional paid integration: neural voices and phoneme-level scoring.
# For a personal installation leave both empty; gTTS and Google STT are used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: comma-separated admin Telegram user IDs
TELEGRAM_ADMIN_IDS=

# Container/runtime
WEB_CONCURRENCY=2
LOAD_INITIAL_DATA=1
